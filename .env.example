# Clave que n8n debe enviar en la cabecera X-API-Key para usar la API de la tienda
API_KEY=cambia-esta-clave
# Webhook de n8n que recibe los eventos de la tienda (dejar vacío para desactivarlo)
# Secreto que n8n exige en cada aviso de la tienda (flujo 00). La app solo puede enviar a una URL, por eso va al final como ?token=. Generar uno propio, p. ej. con: openssl rand -hex 24. No subir el valor real a Git
TIENDA_WEBHOOK_TOKEN=cambia-este-secreto
N8N_WEBHOOK_URL=http://n8n:5678/webhook/tienda?token=cambia-este-secreto
# 1 = cargar datos de ejemplo la primera vez que arranca la app, 0 = arrancar vacía
SEED=1

# Puerto del navegador para la app (solo si el 8000 esta ocupado). Dentro de n8n sigue siendo http://tienda:8000
TIENDA_PORT=8000
# Browser port for n8n. Containers still use http://n8n:5678.
N8N_PORT_HOST=5678
# Direccion de Marisa que recibe los avisos de error (flujo 08). No subir el valor real a Git
TIENDA_EMAIL_AVISOS=
# Buzon desde el que n8n envia los correos (el de la credencial SMTP). No subir el valor real a Git
TIENDA_EMAIL_FROM=

# kDrive history destination for flow 05 (non-secret IDs; token stays in n8n credentials).
KDRIVE_DRIVE_ID=
KDRIVE_DIRECTORY_ID=
# Importe en euros (con punto decimal) a partir del cual Marisa recibe un aviso de venta grande (flujo 04). Solo avisa si la venta es MAYOR. Tras cambiarlo: docker compose up -d
TIENDA_UMBRAL_VENTA_GRANDE=150

# HU-12: only non-secret file paths/IDs here, not secret values.
# setup_secrets.py prepares owner-only files OUTSIDE the repo and sets the host UID.
HU12_TELEGRAM_TOKEN_FILE=${HOME}/.config/paso-firme/secrets/hu12-telegram-token
HU12_BRIDGE_KEY_FILE=${HOME}/.config/paso-firme/secrets/hu12-bridge-key
HU12_BRIDGE_UID=10001
HU12_OWNER_USER_ID=
HU12_OWNER_CHAT_ID=
HU12_N8N_URL=http://n8n:5678/webhook-test/hu12-shop-assistant
HU12_ALLOW_TELEGRAM_SEND=false
# Texto con los datos de pago que ve la clienta en el correo de solicitud (flujo 11). Bizum o IBAN reales: no subir a Git
TIENDA_PAGO_INSTRUCCIONES=Puedes pagar por Bizum al 600 000 000 o por transferencia a ES00 0000 0000 0000 0000 0000 (titular: Zapatería Paso Firme). Indica tu referencia como concepto. Cuando recibamos el abono, tu apartado quedará confirmado y te lo notificaremos por correo.
