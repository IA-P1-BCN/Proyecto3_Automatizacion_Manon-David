<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tobe" targetNamespace="https://paso-firme.example/process-map" exporter="Paso Firme process map">
  <bpmn:collaboration id="Collaboration_tobe">
    <bpmn:participant id="Customer" name="Customer" processRef="Customer_process" />
    <bpmn:participant id="Bank" name="Bank — sends Bizum / transfer notifications" />
    <bpmn:participant id="Assistant" name="Shop assistant — physical shop operations" processRef="Assistant_process" />
    <bpmn:participant id="App" name="Shop app — source of truth for payments, balances, states and vouchers" processRef="App_process" />
    <bpmn:participant id="Automation" name="n8n — event routing, bank notices, schedules and failure alerts" processRef="Automation_process" />
    <bpmn:participant id="Marisa" name="Marisa — review and business decisions" processRef="Marisa_process" />
    <bpmn:messageFlow id="M1" sourceRef="cinitial" targetRef="as" name="Reservation / payment" />
    <bpmn:messageFlow id="M2" sourceRef="a0" targetRef="ps" name="Create via app / API" />
    <bpmn:messageFlow id="M3" sourceRef="p2" targetRef="rs" name="App webhook" />
    <bpmn:messageFlow id="M4" sourceRef="q2" targetRef="rs" name="App webhook" />
    <bpmn:messageFlow id="M5" sourceRef="Bank" targetRef="bs" name="Bank notice" />
    <bpmn:messageFlow id="M6" sourceRef="b2" targetRef="qs" name="Payment API" />
    <bpmn:messageFlow id="M7" sourceRef="x1" targetRef="vs" name="Expiry API" />
    <bpmn:messageFlow id="M8" sourceRef="r2" targetRef="Customer" name="Customer email" />
    <bpmn:messageFlow id="M9" sourceRef="x2" targetRef="hs" name="Shop summary" />
    <bpmn:messageFlow id="M10" sourceRef="z1" targetRef="js" name="Sanitized failure alert" />
    <bpmn:textAnnotation id="Overview">
      <bpmn:text>TO-BE — Layaways with the shop app and n8n
Target operating process, not evidence that local workflows are published. Blue: automation; orange: app; white: people. HU-08 and HU-14 are integrated in dev (checked 2026-10-28). Telegram assistants and new input flows are outside this map.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="CustomerNote">
      <bpmn:text>Customer emails require consent: confirmation, payment receipt, collection notice, reminders and voucher. Missing email uses the shop follow-up path. The initial payment can settle the reservation immediately.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="EventNote">
      <bpmn:text>HU-14: unauthorized requests are rejected; customer messages require consent via 09. Unreadable consent register blocks sends and raises an error. Flows 01/02 use app amounts. Flow 04 uses a configurable threshold. Router ignores apartado.vencido: 06b owns voucher notices. Unknown events are ignored.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="BankNote">
      <bpmn:text>Not a payment: ignore. Invalid, ambiguous, unknown, overpaid or overdue: no registration; ask/notify Marisa. Uncertain POST result: stop and reconcile before retry. Confirmed payment =&gt; normal app event =&gt; receipt via 02, never a second bank-flow receipt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="CloseNote">
      <bpmn:text>One history row per date. Bizum totals include transfers. Manual reruns default to no email. Movements after 23:55 need recalculation of their original date; they do not automatically enter the next date's close.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ExpiryNote">
      <bpmn:text>No voucher receipt from the router. Once expired, the reservation is no longer selected. Failed customer email requires human follow-up; state change alone does not prove successful delivery. A manual app expiry does not trigger the 06b notice path.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="MonthlyNote">
      <bpmn:text>HU-08 integrated in dev; publication is a separate authorization. Settlement month uses latest payment among currently settled reservations (no fecha_liquidacion). Expiry month uses voucher date. Debt is current, not historical month-end debt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ErrorNote">
      <bpmn:text>Local Error Workflow association is required. Manual editor failures do not invoke it. If the alert email also fails, inspect n8n execution history; this map does not claim a second alert channel.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Limits">
      <bpmn:text>Scope: operational layaway map and supporting summaries, not a node-by-node workflow export. No new financial records are created by reports. API business rejections are handled explicitly; unexpected failures go to configured Error Workflow 08. A webhook may be lost: app events are sent once without retries; schedules query the API independently.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Customer_process" isExecutable="false">
    <bpmn:startEvent id="cs" name="Wants to reserve shoes">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="cinitial" name="Choose shoes; pay initial deposit (EUR 5 minimum, up to full price)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cwait" name="Wait; check payment confirmation and deadline">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="cg" name="Reservation outcome?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ccollect" name="Collect the shoes">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ce" name="Shoes collected">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="cpay" name="Make another payment within the deadline and remaining balance">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cvoucher" name="Receive store credit for the amount already paid (not cash)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="cve" name="Reservation expired; voucher received">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="cs" targetRef="cinitial" name="" />
    <bpmn:sequenceFlow id="F2" sourceRef="cinitial" targetRef="cwait" name="" />
    <bpmn:sequenceFlow id="F3" sourceRef="cwait" targetRef="cg" name="" />
    <bpmn:sequenceFlow id="F4" sourceRef="cg" targetRef="ccollect" name="Paid in full" />
    <bpmn:sequenceFlow id="F5" sourceRef="ccollect" targetRef="ce" name="" />
    <bpmn:sequenceFlow id="F6" sourceRef="cg" targetRef="cpay" name="Balance; within deadline" />
    <bpmn:sequenceFlow id="F7" sourceRef="cpay" targetRef="cwait" name="Payment confirmation" />
    <bpmn:sequenceFlow id="F8" sourceRef="cg" targetRef="cvoucher" name="Expired by the shop" />
    <bpmn:sequenceFlow id="F9" sourceRef="cvoucher" targetRef="cve" name="" />
  </bpmn:process>
  <bpmn:process id="Assistant_process" isExecutable="false">
    <bpmn:startEvent id="as" name="Customer requests service">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="as_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="a0" name="Create reservation with initial payment, or register a later payment in the app">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a1" name="Read app confirmation or business rejection; do not assume payment succeeded">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="a2" name="Put shoes aside; hand them over only after app confirms settlement">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="ae" name="Service completed">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F10" sourceRef="as" targetRef="a0" name="" />
    <bpmn:sequenceFlow id="F11" sourceRef="a0" targetRef="a1" name="" />
    <bpmn:sequenceFlow id="F12" sourceRef="a1" targetRef="a2" name="" />
    <bpmn:sequenceFlow id="F13" sourceRef="a2" targetRef="ae" name="" />
  </bpmn:process>
  <bpmn:process id="App_process" isExecutable="false">
    <bpmn:startEvent id="ps" name="Reservation request">
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ps_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="p0" name="Validate price and initial deposit; reject invalid requests">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p1" name="Save reservation and initial payment; deadline = creation date + 90 days">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="p2" name="Return app result; announce apartado.creado after successful creation">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="pe" name="Saved; event announced">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="qs" name="Payment request">
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="qs_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="q0" name="Validate active state, deadline, positive amount and outstanding balance">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="q1" name="Save accepted payment once; update balance and settle at pending = 0">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="q2" name="Return result; announce abono.registrado only after accepted payment">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="qe" name="Saved; event announced">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="vs" name="Expiry API request">
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="vs_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="v0" name="Accept expiry only when active and deadline is strictly before today">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="v1" name="Set vencido and generate voucher for the amount already paid">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="v2" name="Return reservation and voucher; announce apartado.vencido">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ve" name="Saved; event announced">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="pgate" name="Request valid?">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="preject" name="Business rejection; no write">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="qgate" name="Request valid?">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="qreject" name="Business rejection; no write">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="vgate" name="Request valid?">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="vreject" name="Business rejection; no write">
      <bpmn:incoming>F31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F14" sourceRef="ps" targetRef="p0" name="" />
    <bpmn:sequenceFlow id="F15" sourceRef="p1" targetRef="p2" name="" />
    <bpmn:sequenceFlow id="F16" sourceRef="p2" targetRef="pe" name="" />
    <bpmn:sequenceFlow id="F17" sourceRef="qs" targetRef="q0" name="" />
    <bpmn:sequenceFlow id="F18" sourceRef="q1" targetRef="q2" name="" />
    <bpmn:sequenceFlow id="F19" sourceRef="q2" targetRef="qe" name="" />
    <bpmn:sequenceFlow id="F20" sourceRef="vs" targetRef="v0" name="" />
    <bpmn:sequenceFlow id="F21" sourceRef="v1" targetRef="v2" name="" />
    <bpmn:sequenceFlow id="F22" sourceRef="v2" targetRef="ve" name="" />
    <bpmn:sequenceFlow id="F23" sourceRef="p0" targetRef="pgate" name="" />
    <bpmn:sequenceFlow id="F24" sourceRef="pgate" targetRef="p1" name="Yes" />
    <bpmn:sequenceFlow id="F25" sourceRef="pgate" targetRef="preject" name="No: reject" />
    <bpmn:sequenceFlow id="F26" sourceRef="q0" targetRef="qgate" name="" />
    <bpmn:sequenceFlow id="F27" sourceRef="qgate" targetRef="q1" name="Yes" />
    <bpmn:sequenceFlow id="F28" sourceRef="qgate" targetRef="qreject" name="No: reject" />
    <bpmn:sequenceFlow id="F29" sourceRef="v0" targetRef="vgate" name="" />
    <bpmn:sequenceFlow id="F30" sourceRef="vgate" targetRef="v1" name="Yes" />
    <bpmn:sequenceFlow id="F31" sourceRef="vgate" targetRef="vreject" name="No: reject" />
  </bpmn:process>
  <bpmn:process id="Automation_process" isExecutable="false">
    <bpmn:startEvent id="rs" name="App event received">
      <bpmn:outgoing>F32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="rs_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="r0" name="Authenticate app webhook; validate event; respect migration flag">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="r1" name="Route creation / payment / sale to 01 / 02 / 04; check 09 consent for customer notices">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="r2" name="Send permitted customer notice or large-sale alert">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="re" name="Notice sent, held or shop informed">
      <bpmn:incoming>F35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs" name="Authorized bank email arrives">
      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="b0" name="Identify message and fingerprint content; Groq extracts payer, amount and reference only">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="b1" name="Validate extraction; match deterministically; reread app balance, state and deadline">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="b2" name="Register with API duplicate protection; reconcile uncertain results">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="be" name="Payment confirmed; receipt via 02">
      <bpmn:incoming>F42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="bankeligible" name="Clearly eligible?">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="bankconfirmed" name="Payment confirmed?">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="bankreview" name="No financial write / no blind replay. Ignore non-payments; send doubtful or uncertain cases for review.">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="bankheld" name="Ignored or held for review">
      <bpmn:incoming>F44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ds" name="Daily at 23:55 Madrid">
      <bpmn:outgoing>F45</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ds_timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="d0" name="05: query app direct sales and payments for the selected calendar day">
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d1" name="Sum integer cents by method; include initial payments once; empty day = zeros">
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2" name="If requested, attempt email; then update kDrive basedatos.csv even if email failed">
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="de" name="Close saved; failures reported">
      <bpmn:incoming>F48</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ns" name="Daily at 09:00 Madrid">
      <bpmn:outgoing>F49</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ns_timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="n0" name="06: query active reservations; select deadlines exactly 7 or 1 days away">
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n1" name="Check kDrive avisos.csv and 09 consent; send eligible reminder with app amounts">
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n2" name="Record sent notice or missing-email shop alert; report persistence failures">
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ne" name="Customer or shop informed">
      <bpmn:incoming>F52</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="xs" name="Daily at 09:05 Madrid">
      <bpmn:outgoing>F53</bpmn:outgoing>
      <bpmn:timerEventDefinition id="xs_timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="x0" name="06b: query active reservations whose deadline is strictly before today">
      <bpmn:incoming>F53</bpmn:incoming>
      <bpmn:outgoing>F54</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="x1" name="Call expiry API; read voucher; check 09 consent before customer notice">
      <bpmn:incoming>F54</bpmn:incoming>
      <bpmn:outgoing>F55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="x2" name="Send Marisa one summary: shoes returned to sale and customers to contact">
      <bpmn:incoming>F55</bpmn:incoming>
      <bpmn:outgoing>F56</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="xe" name="Expired reservations handled">
      <bpmn:incoming>F56</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ms" name="Day 1 at 09:00 Madrid">
      <bpmn:outgoing>F57</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ms_timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="m0" name="07 / HU-08: query previous calendar month; separate direct sales and payments">
      <bpmn:incoming>F57</bpmn:incoming>
      <bpmn:outgoing>F58</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="m1" name="Report current active debt, new reservations and documented settlement/expiry proxies">
      <bpmn:incoming>F58</bpmn:incoming>
      <bpmn:outgoing>F59</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="m2" name="Email Spanish table; optional local PDF; conversion failure keeps table plus warning">
      <bpmn:incoming>F59</bpmn:incoming>
      <bpmn:outgoing>F60</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="me" name="Monthly report delivered">
      <bpmn:incoming>F60</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="zs" name="Automatic execution fails">
      <bpmn:outgoing>F61</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="z0" name="08: sanitize workflow, failing step and error; exclude secrets and unnecessary personal data">
      <bpmn:incoming>F61</bpmn:incoming>
      <bpmn:outgoing>F62</bpmn:outgoing>
    </bpmn:serviceTask>
