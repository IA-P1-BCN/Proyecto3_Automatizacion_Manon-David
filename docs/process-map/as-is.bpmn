<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_asis" targetNamespace="https://paso-firme.example/process-map" exporter="Paso Firme process map">
  <bpmn:collaboration id="Collaboration_asis">
    <bpmn:participant id="Customer" name="Customer" processRef="Customer_process" />
    <bpmn:participant id="Bank" name="Bank — Bizum / transfer notifications" />
    <bpmn:participant id="Shop" name="Paso Firme — shop assistant and Marisa (manual work)" processRef="Shop_process" />
    <bpmn:messageFlow id="M1" sourceRef="cinitial" targetRef="as" name="Reservation and initial payment" />
    <bpmn:messageFlow id="M2" sourceRef="Bank" targetRef="ks" name="Bank email notice" />
    <bpmn:textAnnotation id="Overview">
      <bpmn:text>AS-IS — Manual layaway process before the shop app
Business map based on the assignment and sample CSVs, not an observed real shop. White: manual work; pale red: pain points. Solid arrows: sequence within one participant; dashed arrows: communication between participants. Deadline: exactly 90 days.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="CustomerNote">
      <bpmn:text>Historical manual process, before the supplied app. Payment and expiry checks depend on the notebook and staff; expiry/voucher handling can be delayed. The first deposit can cover the full price.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Customer_process" isExecutable="false">
    <bpmn:startEvent id="cs" name="Wants to reserve shoes">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="cinitial" name="Choose shoes; pay initial deposit (EUR 5 minimum, up to full price)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cwait" name="Wait; check payment confirmation and deadline">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="cg" name="Reservation outcome?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ccollect" name="Collect the shoes">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ce" name="Shoes collected">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="cpay" name="Make another payment within the deadline and remaining balance">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cvoucher" name="Receive store credit for the amount already paid (not cash)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="cve" name="Reservation expired; voucher received">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="cs" targetRef="cinitial" name="" />
    <bpmn:sequenceFlow id="F2" sourceRef="cinitial" targetRef="cwait" name="" />
    <bpmn:sequenceFlow id="F3" sourceRef="cwait" targetRef="cg" name="" />
    <bpmn:sequenceFlow id="F4" sourceRef="cg" targetRef="ccollect" name="Paid in full" />
    <bpmn:sequenceFlow id="F5" sourceRef="ccollect" targetRef="ce" name="" />
    <bpmn:sequenceFlow id="F6" sourceRef="cg" targetRef="cpay" name="Balance; within deadline" />
    <bpmn:sequenceFlow id="F7" sourceRef="cpay" targetRef="cwait" name="Payment confirmation" />
    <bpmn:sequenceFlow id="F8" sourceRef="cg" targetRef="cvoucher" name="Expired by the shop" />
    <bpmn:sequenceFlow id="F9" sourceRef="cvoucher" targetRef="cve" name="" />
  </bpmn:process>
  <bpmn:process id="Shop_process" isExecutable="false">
    <bpmn:startEvent id="as" name="Reservation requested">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="as_message" />
    </bpmn:startEvent>
    <bpmn:manualTask id="a0" name="Write customer, shoes, size, price and 90-day deadline in the notebook">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="a1" name="Receive initial deposit; record it in the notebook and sales Excel">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="a2" name="Check remaining balance; put shoes aside, or hand over if fully paid">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="ae" name="Reservation recorded">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs" name="Payment made in the shop">
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="b0" name="Find the reservation and check its deadline">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="b1" name="Record payment in the notebook and Excel">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="b2" name="Calculate balance; hand over shoes when fully paid">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="be" name="Payment noted">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ks" name="Bank notice received">
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ks_message" />
    </bpmn:startEvent>
    <bpmn:manualTask id="k0" name="Read notice; ignore advertising and other non-payment messages">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="k1" name="Try to identify the reservation; doubtful cases require review">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="k2" name="Record matched payment in notebook and Excel; some payments are missed">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="ke" name="Payment noted or unresolved">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ds" name="Deadline has passed">
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ds_timer" />
    </bpmn:startEvent>
    <bpmn:manualTask id="d0" name="Notice overdue unpaid reservation, if remembered">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="d1" name="Check amount already paid; write a store-credit voucher">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="d2" name="Return shoes to sale and give the voucher to the customer">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="de" name="Reservation expired">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="es" name="Every evening">
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:timerEventDefinition id="es_timer" />
    </bpmn:startEvent>
    <bpmn:manualTask id="e0" name="Read direct sales and layaway payments, including initial deposits">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="e1" name="Add daily amounts with a calculator; avoid counting deposits twice">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="e2" name="Write daily totals in Excel">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="ee" name="Daily close prepared">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="fs" name="At month end">
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:timerEventDefinition id="fs_timer" />
    </bpmn:startEvent>
    <bpmn:manualTask id="f0" name="Read the monthly Excel and reservation notebook">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="f1" name="Calculate monthly collections and outstanding balances by hand">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="f2" name="Review figures; current debt is not readily available between reports">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="fe" name="Monthly summary prepared">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F10" sourceRef="as" targetRef="a0" name="" />
    <bpmn:sequenceFlow id="F11" sourceRef="a0" targetRef="a1" name="" />
    <bpmn:sequenceFlow id="F12" sourceRef="a1" targetRef="a2" name="" />
    <bpmn:sequenceFlow id="F13" sourceRef="a2" targetRef="ae" name="" />
    <bpmn:sequenceFlow id="F14" sourceRef="bs" targetRef="b0" name="" />
    <bpmn:sequenceFlow id="F15" sourceRef="b0" targetRef="b1" name="" />
    <bpmn:sequenceFlow id="F16" sourceRef="b1" targetRef="b2" name="" />
    <bpmn:sequenceFlow id="F17" sourceRef="b2" targetRef="be" name="" />
    <bpmn:sequenceFlow id="F18" sourceRef="ks" targetRef="k0" name="" />
    <bpmn:sequenceFlow id="F19" sourceRef="k0" targetRef="k1" name="" />
    <bpmn:sequenceFlow id="F20" sourceRef="k1" targetRef="k2" name="" />
    <bpmn:sequenceFlow id="F21" sourceRef="k2" targetRef="ke" name="" />
    <bpmn:sequenceFlow id="F22" sourceRef="ds" targetRef="d0" name="" />
    <bpmn:sequenceFlow id="F23" sourceRef="d0" targetRef="d1" name="" />
    <bpmn:sequenceFlow id="F24" sourceRef="d1" targetRef="d2" name="" />
    <bpmn:sequenceFlow id="F25" sourceRef="d2" targetRef="de" name="" />
    <bpmn:sequenceFlow id="F26" sourceRef="es" targetRef="e0" name="" />
    <bpmn:sequenceFlow id="F27" sourceRef="e0" targetRef="e1" name="" />
    <bpmn:sequenceFlow id="F28" sourceRef="e1" targetRef="e2" name="" />
    <bpmn:sequenceFlow id="F29" sourceRef="e2" targetRef="ee" name="" />
    <bpmn:sequenceFlow id="F30" sourceRef="fs" targetRef="f0" name="" />
    <bpmn:sequenceFlow id="F31" sourceRef="f0" targetRef="f1" name="" />
    <bpmn:sequenceFlow id="F32" sourceRef="f1" targetRef="f2" name="" />
    <bpmn:sequenceFlow id="F33" sourceRef="f2" targetRef="fe" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_asis">
    <bpmndi:BPMNPlane id="Plane_asis" bpmnElement="Collaboration_asis">
      <bpmndi:BPMNShape id="Customer_di" bpmnElement="Customer" isHorizontal="true">
