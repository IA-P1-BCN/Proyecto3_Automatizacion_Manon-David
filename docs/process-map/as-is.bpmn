      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fs_di" bpmnElement="fs">
        <dc:Bounds x="110" y="1740" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="58.0" y="1784" width="140" height="58" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f0_di" bpmnElement="f0" bioc:fill="#fdecea">
        <dc:Bounds x="240" y="1720" width="220" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f1_di" bpmnElement="f1" bioc:fill="#fdecea">
        <dc:Bounds x="550" y="1720" width="220" height="76" />
      </bpmndi:BPMNShape>
