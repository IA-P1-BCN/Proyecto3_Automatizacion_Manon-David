        200
      ],
      "parameters": {
        "jsCode": "if ($('Check Token').first().json.misconfigured) throw new Error('TIENDA_WEBHOOK_TOKEN está vacío en n8n: el router rechaza todos los avisos de la tienda.');\nreturn [];"
